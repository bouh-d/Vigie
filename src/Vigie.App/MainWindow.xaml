<Window x:Class="Vigie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vigie.App"
        xmlns:res="clr-namespace:Vigie.App.Resources"
        xmlns:vm="clr-namespace:Vigie.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{x:Static res:Strings.AppTitle}"
        Icon="pack://application:,,,/Resources/vigie.ico"
        Width="560" MinWidth="480" MinHeight="320" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

  <Window.Resources>
    <local:EnumToBooleanConverter x:Key="EnumBool" />
    <local:BooleanToVisibilityConverter x:Key="BoolVis" />
    <local:InverseBooleanConverter x:Key="NotBool" />
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- Power -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding PowerStatusText}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,10"
               AutomationProperties.AutomationId="PowerStatus" />

    <StackPanel DockPanel.Dock="Top">
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowBatteryWarning, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{x:Static res:Strings.Warn_Battery}" />
      </Border>
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowDegradedBanner, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{Binding DegradedText}" />
      </Border>
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowSleepBanner, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{Binding SleepBannerText}" />
      </Border>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{x:Static res:Strings.Warn_ModernStandbyBattery}"
                 Visibility="{Binding ShowModernStandbyInfo, Converter={StaticResource BoolVis}}" />
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{x:Static res:Strings.Warn_RebootPending}"
                 Visibility="{Binding ShowRebootWarning, Converter={StaticResource BoolVis}}" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="0,0,6,0">

        <!-- Wake session -->
        <DockPanel Margin="0,0,0,6">
          <Ellipse DockPanel.Dock="Left">
            <Ellipse.Style>
              <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSessionRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ActiveDotBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding SessionStateText}" FontSize="18" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="SessionState" />
        </DockPanel>
        <ProgressBar Style="{StaticResource SessionProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,2,0,6"
                     Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolVis}}"
                     AutomationProperties.Name="{Binding SessionStateText}" />

        <StackPanel IsEnabled="{Binding OptionsEnabled}" Margin="0,10,0,0">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Duration_Label}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ComboBox Width="280" ItemsSource="{Binding Durations}" SelectedValuePath="Choice" SelectedValue="{Binding SelectedDuration}"
                        AutomationProperties.Name="{x:Static res:Strings.Duration_Label}" AutomationProperties.AutomationId="Duration" />
              <TextBox Width="48" Margin="8,0,0,0" Text="{Binding CustomMinutes}" VerticalContentAlignment="Center"
                       Visibility="{Binding IsCustomDuration, Converter={StaticResource BoolVis}}"
                       AutomationProperties.Name="{x:Static res:Strings.Duration_CustomName}" />
              <TextBlock Text="{x:Static res:Strings.Duration_CustomUnit}" Margin="4,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding IsCustomDuration, Converter={StaticResource BoolVis}}" />
            </StackPanel>
          </Grid>
          <ComboBox Width="280" HorizontalAlignment="Left" Margin="72,-2,0,10" ItemsSource="{Binding TaskTargets}" SelectedItem="{Binding SelectedTaskTarget}"
                    Visibility="{Binding IsUntilTask, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="{x:Static res:Strings.Claude_TrackTarget}" />

          <CheckBox Content="{x:Static res:Strings.Opt_LidClosed}" IsChecked="{Binding WorkWithLidClosed}"
                    ToolTip="{x:Static res:Strings.Tip_LidClosed}" AutomationProperties.AutomationId="WorkWithLidClosed" />
          <TextBlock Text="{x:Static res:Strings.Opt_LidClosedNote}" Style="{StaticResource Hint}" Margin="22,2,0,8"
                     Visibility="{Binding WorkWithLidClosed, Converter={StaticResource BoolVis}}" />

          <CheckBox Content="{Binding ActivityLockLabel}" IsChecked="{Binding ActivityLockEnabled}"
                    ToolTip="{x:Static res:Strings.Tip_ActivityLock}" AutomationProperties.HelpText="{x:Static res:Strings.Tip_ActivityLock}"
                    AutomationProperties.AutomationId="ActivityLock" />
        </StackPanel>
        <TextBlock Text="{Binding ActivityLockStatusText}" Style="{StaticResource Hint}" Margin="22,2,0,0"
                   Visibility="{Binding ActivityLockEnabled, Converter={StaticResource BoolVis}}"
                   AutomationProperties.AutomationId="ActivityLockStatus" />

        <Grid Margin="0,16,0,0">
          <Button Content="{x:Static res:Strings.Btn_Start}" Command="{Binding StartSessionCommand}" HorizontalAlignment="Left" Padding="28,7"
                  Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                  AutomationProperties.AutomationId="StartSession" />
          <Button Content="{x:Static res:Strings.Btn_Stop}" Command="{Binding StopSessionCommand}" HorizontalAlignment="Left" Padding="28,7"
                  Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolVis}}"
                  AutomationProperties.AutomationId="StopSession" />
        </Grid>

        <Separator Margin="0,18,0,8" />

        <!-- Claude Code -->
        <Expander HorizontalContentAlignment="Stretch" Margin="0,2,0,0"
                  AutomationProperties.Name="{x:Static res:Strings.Zone_Claude}" AutomationProperties.AutomationId="ClaudeCode">
          <Expander.Header>
            <DockPanel>
              <Ellipse DockPanel.Dock="Left">
                <Ellipse.Style>
                  <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ClaudeActivity}" Value="Running">
                        <Setter Property="Fill" Value="{DynamicResource ActiveDotBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ClaudeActivity}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource ErrorDotBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.Zone_Claude}" FontWeight="SemiBold" Margin="0,0,10,0" />
              <TextBlock Text="{Binding ClaudeStateText}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                         TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ClaudeState" />
            </DockPanel>
          </Expander.Header>

          <StackPanel Margin="22,10,0,4">
            <ItemsControl ItemsSource="{Binding DetectedProcesses}" Margin="0,0,0,8" Focusable="False"
                          AutomationProperties.Name="{x:Static res:Strings.Claude_Processes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Display}" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,0,0,8" Visibility="{Binding ClaudeAvailable, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
              <TextBlock Text="{x:Static res:Strings.Claude_Missing}" Style="{StaticResource WarningText}" />
              <TextBlock>
                <Hyperlink NavigateUri="{x:Static res:Strings.Claude_InstallUri}" RequestNavigate="OnRequestNavigate">
                  <Run Text="{x:Static res:Strings.Claude_InstallLinkText}" />
                </Hyperlink>
              </TextBlock>
            </StackPanel>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Folder}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Column="1" Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Folder}" />
              <Button Grid.Column="2" Content="{x:Static res:Strings.Claude_Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Padding="10,4" />
            </Grid>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Prompt}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,3,8,0" />
              <TextBox Grid.Column="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinLines="2" MaxLines="5" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Prompt}" />
            </Grid>

            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Mode}" Style="{StaticResource FieldLabel}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Claude_Mode_Autonomous}" Margin="0,0,16,0"
                             IsChecked="{Binding IsAutonomous}" ToolTip="{x:Static res:Strings.Tip_Autonomous}" />
                <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Claude_Mode_Interactive}"
                             IsChecked="{Binding IsAutonomous, Converter={StaticResource NotBool}}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{x:Static res:Strings.Warn_Interactive}" Style="{StaticResource Hint}" Margin="90,2,0,6"
                       Visibility="{Binding IsAutonomous, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />

            <Grid Margin="0,6,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Permissions}" Style="{StaticResource FieldLabel}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission}"
                        AutomationProperties.Name="{x:Static res:Strings.Claude_Permissions}" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Args}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Column="1" Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Args}" />
            </Grid>

            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsAutonomous, Converter={StaticResource BoolVis}}">
              <CheckBox Content="{x:Static res:Strings.Opt_ResumeAfterLimit}" IsChecked="{Binding ResumeAfterUsageLimit}"
                        AutomationProperties.AutomationId="ResumeAfterLimit" />
              <TextBlock Text="{x:Static res:Strings.Opt_ResumeAfterLimitNote}" Style="{StaticResource Hint}" Margin="20,2,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <Button Content="{x:Static res:Strings.Btn_Launch}" Command="{Binding LaunchClaudeCommand}" IsEnabled="{Binding CanLaunchClaude}"
                      Padding="16,6" Margin="0,0,8,0" AutomationProperties.AutomationId="LaunchClaude" />
              <Button Content="{x:Static res:Strings.Btn_Interrupt}" Command="{Binding InterruptClaudeCommand}" IsEnabled="{Binding CanInterruptClaude}"
                      Padding="16,6" AutomationProperties.AutomationId="InterruptClaude" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Advanced settings -->
        <Expander Header="{x:Static res:Strings.Opt_Advanced}" Margin="0,6,0,0" AutomationProperties.AutomationId="AdvancedSettings">
          <StackPanel Margin="22,10,0,4" IsEnabled="{Binding OptionsEnabled}">
            <CheckBox Content="{x:Static res:Strings.Opt_KeepDisplay}" IsChecked="{Binding KeepDisplayOn}" Margin="0,0,0,6"
                      ToolTip="{x:Static res:Strings.Warn_KeepDisplay}" />
            <CheckBox Content="{x:Static res:Strings.Opt_LockOnLid}" IsChecked="{Binding LockOnLidClose}" Margin="0,0,0,6"
                      IsEnabled="{Binding LockOptionEnabled}" ToolTip="{x:Static res:Strings.Tip_LockOnLid}"
                      AutomationProperties.AutomationId="LockOnLidClose" />
            <CheckBox Content="{x:Static res:Strings.Opt_SuspendAtEnd}" IsChecked="{Binding SuspendAtEnd}" Margin="0,0,0,6"
                      ToolTip="{x:Static res:Strings.Tip_SuspendAtEnd}" AutomationProperties.AutomationId="SuspendAtEnd" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{x:Static res:Strings.Opt_BatteryStopPrefix}" VerticalAlignment="Center" />
              <TextBox Width="40" Text="{Binding BatteryThreshold}" Margin="6,0" VerticalContentAlignment="Center"
                       ToolTip="{x:Static res:Strings.Tip_BatteryStop}" AutomationProperties.Name="{x:Static res:Strings.Opt_BatteryStopSuffix}" />
              <TextBlock Text="{x:Static res:Strings.Opt_BatteryStopSuffix}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{x:Static res:Strings.Duration_CapLabel}" VerticalAlignment="Center" />
              <TextBox Width="34" Text="{Binding TaskCapHours}" Margin="6,0" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.Duration_CapName}" />
              <TextBlock Text="{x:Static res:Strings.Duration_CapUnit}" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.Opt_ModernStandbyCompat}" IsChecked="{Binding ModernStandbyCompatibility}"
                      ToolTip="{x:Static res:Strings.Tip_ModernStandbyCompat}"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tip_ModernStandbyCompat}" />

            <TextBlock Text="{x:Static res:Strings.Adv_ActivityHeader}" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="{x:Static res:Strings.Adv_Response}" Style="{StaticResource FieldLabel}" Width="110" />
              <RadioButton GroupName="ActivityResponse" Content="{x:Static res:Strings.Adv_ResponseLock}" Margin="0,0,16,0" VerticalAlignment="Center"
                           IsChecked="{Binding ActivityResponse, Converter={StaticResource EnumBool}, ConverterParameter=Lock}" />
              <RadioButton GroupName="ActivityResponse" Content="{x:Static res:Strings.Adv_ResponseSleep}" VerticalAlignment="Center"
                           IsChecked="{Binding ActivityResponse, Converter={StaticResource EnumBool}, ConverterParameter=Sleep}" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.Adv_SleepNote}" Style="{StaticResource Hint}" Margin="110,0,0,4"
                       Visibility="{Binding IsSleepResponse, Converter={StaticResource BoolVis}}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <TextBlock Text="{x:Static res:Strings.Adv_Shortcut}" Style="{StaticResource FieldLabel}" Width="110" />
              <TextBox Width="160" IsReadOnly="True" IsReadOnlyCaretVisible="False" Text="{Binding ActivityShortcutText, Mode=OneWay}"
                       VerticalContentAlignment="Center" PreviewKeyDown="OnShortcutKeyDown"
                       AutomationProperties.Name="{x:Static res:Strings.Adv_ShortcutName}" AutomationProperties.AutomationId="ActivityShortcut" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.Adv_ShortcutInvalid}" Style="{StaticResource WarningText}" Margin="110,0,0,4"
                       Visibility="{Binding ShortcutRejected, Converter={StaticResource BoolVis}}" />
            <TextBlock Text="{x:Static res:Strings.Adv_ShortcutHint}" Style="{StaticResource Hint}" Margin="110,0,0,0" />
          </StackPanel>
        </Expander>

        <!-- Journal -->
        <Expander Header="{x:Static res:Strings.Zone_Journal}" Margin="0,6,0,0" AutomationProperties.AutomationId="Journal">
          <StackPanel Margin="0,10,0,0">
            <ListBox ItemsSource="{Binding Journal}" Height="160" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{x:Static res:Strings.Zone_Journal}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="{x:Static res:Strings.Btn_OpenLogs}" Command="{Binding OpenLogsCommand}" Padding="10,4" Margin="0,0,8,0" />
              <Button Content="{x:Static res:Strings.Btn_Copy}" Command="{Binding CopyLogCommand}" Padding="10,4" />
            </StackPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
