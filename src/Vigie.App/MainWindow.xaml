<Window x:Class="Vigie.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vigie.App"
        xmlns:res="clr-namespace:Vigie.App.Resources"
        xmlns:vm="clr-namespace:Vigie.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{x:Static res:Strings.AppTitle}"
        Icon="pack://application:,,,/Resources/vigie.ico"
        Width="620" Height="860" MinWidth="560" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

  <Window.Resources>
    <local:EnumToBooleanConverter x:Key="EnumBool" />
    <local:BooleanToVisibilityConverter x:Key="BoolVis" />
    <local:InverseBooleanConverter x:Key="NotBool" />
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- Power -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding PowerStatusText}" Margin="0,0,0,8"
               AutomationProperties.AutomationId="PowerStatus" />
    <Separator DockPanel.Dock="Top" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Top">
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowBatteryWarning, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{x:Static res:Strings.Warn_Battery}" />
      </Border>
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowDegradedBanner, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{Binding DegradedText}" />
      </Border>
      <Border Style="{StaticResource WarningBanner}" Visibility="{Binding ShowSleepBanner, Converter={StaticResource BoolVis}}">
        <TextBlock Style="{StaticResource WarningText}" Text="{Binding SleepBannerText}" />
      </Border>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{x:Static res:Strings.Warn_ModernStandbyBattery}"
                 Visibility="{Binding ShowModernStandbyInfo, Converter={StaticResource BoolVis}}" />
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{x:Static res:Strings.Warn_RebootPending}"
                 Visibility="{Binding ShowRebootWarning, Converter={StaticResource BoolVis}}" />
    </StackPanel>

    <!-- Journal -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" BorderThickness="0,1,0,0">
      <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Zone_Journal}" Style="{StaticResource SectionHeader}" Margin="0,8,0,6" />
        <ListBox ItemsSource="{Binding Journal}" Height="130" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{x:Static res:Strings.Zone_Journal}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="{x:Static res:Strings.Btn_OpenLogs}" Command="{Binding OpenLogsCommand}" Padding="10,4" Margin="0,0,8,0" />
          <Button Content="{x:Static res:Strings.Btn_Copy}" Command="{Binding CopyLogCommand}" Padding="10,4" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>

        <!-- Wake session -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Ellipse>
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSessionRunning}" Value="True">
                          <Setter Property="Fill" Value="{DynamicResource ActiveDotBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding SessionBadgeText}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.Zone_Session}" Style="{StaticResource SectionHeader}" />
            </DockPanel>

            <TextBlock Text="{Binding SessionStateText}" FontSize="16" Margin="0,0,0,4"
                       AutomationProperties.AutomationId="SessionState" />
            <ProgressBar Style="{StaticResource SessionProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,10"
                         AutomationProperties.Name="{Binding SessionStateText}" />

            <StackPanel IsEnabled="{Binding OptionsEnabled}">
              <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="{x:Static res:Strings.Duration_Label}" Style="{StaticResource FieldLabel}" Width="62" />
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_15m}" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=FifteenMinutes}" />
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_1h}" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=OneHour}" />
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_2h}" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=TwoHours}" />
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_4h}" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=FourHours}" />
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_Custom}" Margin="0,0,6,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=Custom}" />
                <TextBox Width="44" Text="{Binding CustomMinutes}" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{x:Static res:Strings.Duration_CustomName}" />
                <TextBlock Text="{x:Static res:Strings.Duration_CustomUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
              </WrapPanel>

              <WrapPanel Margin="62,0,0,6">
                <RadioButton GroupName="Duration" Content="{x:Static res:Strings.Duration_UntilTask}" Margin="0,0,6,0" VerticalAlignment="Center"
                             IsChecked="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=UntilTask}" />
                <TextBox Width="34" Text="{Binding TaskCapHours}" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{x:Static res:Strings.Duration_CapName}" />
                <TextBlock Text="{x:Static res:Strings.Duration_CapUnit}" Margin="4,0,8,0" VerticalAlignment="Center" />
                <ComboBox Width="220" ItemsSource="{Binding TaskTargets}" SelectedItem="{Binding SelectedTaskTarget}"
                          IsEnabled="{Binding SelectedDuration, Converter={StaticResource EnumBool}, ConverterParameter=UntilTask, Mode=OneWay}"
                          AutomationProperties.Name="{x:Static res:Strings.Claude_TrackTarget}" />
              </WrapPanel>

              <WrapPanel>
                <CheckBox Content="{x:Static res:Strings.Opt_LidClosed}" IsChecked="{Binding WorkWithLidClosed}" Margin="0,0,16,4"
                          ToolTip="{x:Static res:Strings.Tip_LidClosed}" />
                <CheckBox Content="{x:Static res:Strings.Opt_KeepDisplay}" IsChecked="{Binding KeepDisplayOn}" Margin="0,0,16,4"
                          ToolTip="{x:Static res:Strings.Warn_KeepDisplay}" />
              </WrapPanel>
              <CheckBox Content="{x:Static res:Strings.Opt_LockOnLid}" IsChecked="{Binding LockOnLidClose}" Margin="0,0,0,4"
                        IsEnabled="{Binding LockOptionEnabled}" ToolTip="{x:Static res:Strings.Tip_LockOnLid}"
                        AutomationProperties.AutomationId="LockOnLidClose" />
              <CheckBox Content="{x:Static res:Strings.Opt_SuspendAtEnd}" IsChecked="{Binding SuspendAtEnd}" Margin="0,0,0,4"
                        ToolTip="{x:Static res:Strings.Tip_SuspendAtEnd}" AutomationProperties.AutomationId="SuspendAtEnd" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{x:Static res:Strings.Opt_BatteryStopPrefix}" VerticalAlignment="Center" />
                <TextBox Width="40" Text="{Binding BatteryThreshold}" Margin="6,0" VerticalContentAlignment="Center"
                         ToolTip="{x:Static res:Strings.Tip_BatteryStop}" AutomationProperties.Name="{x:Static res:Strings.Opt_BatteryStopSuffix}" />
                <TextBlock Text="{x:Static res:Strings.Opt_BatteryStopSuffix}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.Opt_LidClosedNote}" Style="{StaticResource Hint}" Margin="0,4,0,4"
                         Visibility="{Binding WorkWithLidClosed, Converter={StaticResource BoolVis}}" />

              <Expander Header="{x:Static res:Strings.Opt_Advanced}" Margin="0,4,0,0">
                <CheckBox Content="{x:Static res:Strings.Opt_ModernStandbyCompat}" IsChecked="{Binding ModernStandbyCompatibility}"
                          Margin="20,6,0,0" ToolTip="{x:Static res:Strings.Tip_ModernStandbyCompat}"
                          AutomationProperties.HelpText="{x:Static res:Strings.Tip_ModernStandbyCompat}" />
              </Expander>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="{x:Static res:Strings.Btn_Start}" Command="{Binding StartSessionCommand}" IsEnabled="{Binding OptionsEnabled}"
                      Padding="16,6" Margin="0,0,8,0" AutomationProperties.AutomationId="StartSession" />
              <Button Content="{x:Static res:Strings.Btn_Stop}" Command="{Binding StopSessionCommand}" IsEnabled="{Binding IsSessionRunning}"
                      Padding="16,6" AutomationProperties.AutomationId="StopSession" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Claude Code -->
        <Border Style="{StaticResource Card}" BorderThickness="0">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Ellipse>
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ClaudeActivity}" Value="Running">
                          <Setter Property="Fill" Value="{DynamicResource ActiveDotBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClaudeActivity}" Value="Error">
                          <Setter Property="Fill" Value="{DynamicResource ErrorDotBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ClaudeBadgeText}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.Zone_Claude}" Style="{StaticResource SectionHeader}" />
            </DockPanel>

            <TextBlock Text="{Binding ClaudeStateText}" Margin="0,0,0,6" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ClaudeState" />

            <ItemsControl ItemsSource="{Binding DetectedProcesses}" Margin="0,0,0,8" Focusable="False"
                          AutomationProperties.Name="{x:Static res:Strings.Claude_Processes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Display}" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,0,0,8" Visibility="{Binding ClaudeAvailable, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
              <TextBlock Text="{x:Static res:Strings.Claude_Missing}" Style="{StaticResource WarningText}" />
              <TextBlock>
                <Hyperlink NavigateUri="{x:Static res:Strings.Claude_InstallUrl}" RequestNavigate="OnRequestNavigate">
                  <Run Text="{x:Static res:Strings.Claude_InstallLinkText}" />
                </Hyperlink>
              </TextBlock>
            </StackPanel>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Folder}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Column="1" Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Folder}" />
              <Button Grid.Column="2" Content="{x:Static res:Strings.Claude_Browse}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Padding="10,4" />
            </Grid>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Prompt}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,3,8,0" />
              <TextBox Grid.Column="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinLines="2" MaxLines="5" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Prompt}" />
            </Grid>

            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Mode}" Style="{StaticResource FieldLabel}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Claude_Mode_Autonomous}" Margin="0,0,16,0"
                             IsChecked="{Binding IsAutonomous}" ToolTip="{x:Static res:Strings.Tip_Autonomous}" />
                <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Claude_Mode_Interactive}"
                             IsChecked="{Binding IsAutonomous, Converter={StaticResource NotBool}}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{x:Static res:Strings.Warn_Interactive}" Style="{StaticResource Hint}" Margin="90,2,0,6"
                       Visibility="{Binding IsAutonomous, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />

            <Grid Margin="0,6,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Permissions}" Style="{StaticResource FieldLabel}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission}"
                        AutomationProperties.Name="{x:Static res:Strings.Claude_Permissions}" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Claude_Args}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Column="1" Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.Claude_Args}" />
            </Grid>

            <StackPanel Orientation="Horizontal">
              <Button Content="{x:Static res:Strings.Btn_Launch}" Command="{Binding LaunchClaudeCommand}" IsEnabled="{Binding CanLaunchClaude}"
                      Padding="16,6" Margin="0,0,8,0" AutomationProperties.AutomationId="LaunchClaude" />
              <Button Content="{x:Static res:Strings.Btn_Interrupt}" Command="{Binding InterruptClaudeCommand}" IsEnabled="{Binding CanInterruptClaude}"
                      Padding="16,6" AutomationProperties.AutomationId="InterruptClaude" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
